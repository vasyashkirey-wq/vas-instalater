---
layout: base.njk
---
{%- set tx = t[lang] -%}
{%- set k = kontakty -%}
{%- set tel = k.telefon | digits -%}
{%- set name = svc | loc("nazev", lang) -%}

<section class="hero svc-hero">
  <div class="wrap">
    <div class="hero-text">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="{{ tx.url }}">{{ tx.homeCrumb }}</a> / <a href="{{ tx.url }}#sluzby">{{ tx.servicesEyebrow }}</a></nav>
      <h1>{{ name }} {{ tx.inCity }}</h1>
      <p class="lead">{{ svc | loc("popis", lang) }}</p>
      <div class="btns">
        <a class="btn btn-primary" href="tel:+{{ tel }}" data-umami-event="tel-service">{{ tx.call }}</a>
        {%- if k.whatsapp %}<a class="btn btn-ghost" href="https://wa.me/{{ tel }}" data-umami-event="whatsapp-service">{{ tx.waPhoto }}</a>{% endif %}
      </div>
    </div>
    <aside class="svc-price">
      <span class="eyebrow">{{ tx.svcPrice }}</span>
      <b>{{ svc.cena | price(true, tx) }}</b>
      <span class="muted">{{ tx.dph(k.platce_dph) }}</span>
      <a href="{{ tx.url }}#cenik">{{ tx.fullPrice }}</a>
    </aside>
  </div>
</section>

<section class="section">
  <div class="wrap svc-body">
    <div class="svc-text">
      {%- for para in (svc | loc("text", lang)) | paras %}
      <p>{{ para }}</p>
      {%- endfor %}
    </div>
    {%- set items = svc["body_" + lang] or svc.body_cz %}
    {%- if items and items.length %}
    <div class="svc-list">
      <h2>{{ tx.svcWhat }}</h2>
      <ul>
        {%- for it in items %}<li>{{ it }}</li>{% endfor %}
      </ul>
    </div>
    {%- endif %}
  </div>
</section>

<section class="section-tight">
  <div class="wrap">
    <div class="area">
      <div>
        <h2 style="font-size:28px;letter-spacing:-.5px">{{ tx.svcCta }}</h2>
        <p class="muted">{{ tx.svcCtaText }}</p>
      </div>
      <div class="btns">
        <a class="btn btn-primary" href="tel:+{{ tel }}" data-umami-event="tel-service-cta">{{ k.telefon }}</a>
        <a class="btn btn-ghost" href="#kontakt">{{ tx.order }}</a>
      </div>
    </div>
  </div>
</section>

<section class="section-tight">
  <div class="wrap">
    <h2 class="h2" style="margin-bottom:20px">{{ tx.svcOther }}</h2>
    <ul class="pills other-svc">
      {%- for s in sluzby %}{% if s.slug != svc.slug %}
      <li><a href="{{ tx.servicesPath }}{{ s.slug }}/">{{ s | loc("nazev", lang) }}</a></li>
      {%- endif %}{% endfor %}
    </ul>
  </div>
</section>

<section class="section-tight">
  <div class="wrap faq">
    <h2 class="h2" style="margin-bottom:24px">{{ tx.faqH }}</h2>
    {%- for f in faq %}
    <details><summary>{{ f | loc("otazka", lang) }}</summary><p>{{ f | loc("odpoved", lang) }}</p></details>
    {%- endfor %}
  </div>
</section>
